<div class="card mb-6">
  <div class="card-header">
    <h5 class="card-title">Question</h5>
  </div>
  <div class="card-body">
    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 grid grid-cols-12 gap-6" data-controller="spree-reviews-slug-field">
        <div class="col-span-12 md:col-span-6">
          <%= f.spree_text_field :label,
                                 required: true,
                                 autofocus: f.object.new_record?,
                                 data: {
                                   spree_reviews_slug_field_target: 'source',
                                   action: 'input->spree-reviews-slug-field#sync'
                                 } %>
        </div>
        <div class="col-span-12 md:col-span-6">
          <%= f.spree_text_field :key,
                                 required: true,
                                 data: {
                                   spree_reviews_slug_field_target: 'slug',
                                   action: 'input->spree-reviews-slug-field#markManual'
                                 },
                                 help: 'Used by APIs and storefront filters. Generated from the label using lowercase underscores.' %>
        </div>
      </div>
      <div class="col-span-12 md:col-span-6">
        <%= f.spree_select :kind, Spree::ReviewQuestion::KINDS.map { |kind| [kind.humanize, kind] }, { include_blank: false, label: 'Kind' } %>
      </div>
      <div class="col-span-12 md:col-span-6">
        <%= f.spree_select :applies_to, Spree::ReviewQuestion::APPLIES_TO.map { |scope| [scope.humanize, scope] }, { include_blank: false, label: 'Applies to' } %>
      </div>
      <div class="col-span-12 md:col-span-6">
        <%= f.spree_select :product_id, @products.map { |product| [product.name, product.id] }, { include_blank: 'All products', label: 'Product' } %>
      </div>
      <div class="col-span-12 md:col-span-6">
        <%= f.spree_select :category_id, @category_options, { include_blank: 'Select a category', label: 'Category' } %>
        <p class="mt-2 text-sm text-gray-500">
          Select a parent or child category. Category-scoped questions apply to the selected category and all descendant categories.
        </p>
        <% if f.object.category.present? %>
          <p class="mt-1 text-sm text-gray-500">
            Current category matches <%= pluralize(@category_product_counts.fetch(f.object.category_id, 0), 'product') %>, including products in descendant categories.
          </p>
        <% end %>
      </div>
      <div class="col-span-12 border-t border-gray-200 pt-6">
        <div class="grid grid-cols-12 gap-6">
          <div class="col-span-12 lg:col-span-4">
            <h6 class="text-sm font-semibold text-gray-900">Settings</h6>
            <p class="mt-1 text-sm text-gray-500">
              Set the display order and storefront behavior for this question.
            </p>
          </div>

          <div class="col-span-12 lg:col-span-8">
            <div class="divide-y divide-gray-200 rounded-lg border border-gray-200">
              <div class="grid grid-cols-12 gap-4 p-4">
                <div class="col-span-12 md:col-span-7">
                  <%= f.label :position, 'Position', class: 'block text-sm font-semibold text-gray-900' %>
                  <p class="mt-1 text-sm leading-5 text-gray-500">
                    Lower numbers appear first in storefront forms and filters.
                  </p>
                </div>
                <div class="col-span-12 md:col-span-5">
                  <%= f.number_field :position, min: 0, class: 'form-input w-full' %>
                </div>
              </div>

              <div class="p-4">
                <div class="custom-control form-checkbox">
                  <%= f.check_box :filterable, class: 'custom-control-input' %>
                  <%= f.label :filterable, 'Filterable', class: 'custom-control-label text-sm font-semibold text-gray-900' %>
                </div>
                <p class="mt-2 ml-6 pl-1 text-sm leading-5 text-gray-500">
                  Customers can filter reviews by answers to this question.
                </p>
              </div>

              <div class="p-4">
                <div class="custom-control form-checkbox">
                  <%= f.check_box :required, class: 'custom-control-input' %>
                  <%= f.label :required, 'Required', class: 'custom-control-label text-sm font-semibold text-gray-900' %>
                </div>
                <p class="mt-2 ml-6 pl-1 text-sm leading-5 text-gray-500">
                  Customers must answer this question before submitting a review.
                </p>
              </div>

              <div class="p-4">
                <div class="custom-control form-checkbox">
                  <%= f.check_box :active, class: 'custom-control-input' %>
                  <%= f.label :active, 'Active', class: 'custom-control-label text-sm font-semibold text-gray-900' %>
                </div>
                <p class="mt-2 ml-6 pl-1 text-sm leading-5 text-gray-500">
                  Show this question in storefront review forms and filters.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<template data-nested-form-target="template">
  <%= f.fields_for :options, Spree::ReviewQuestionOption.new, child_index: 'NEW_RECORD' do |option_form| %>
    <%= render 'option_fields', f: option_form %>
  <% end %>
</template>

<div class="card mb-6">
  <div class="card-header flex justify-between items-center">
    <h5 class="card-title">Answer options</h5>
    <span class="text-sm text-gray-500"><%= f.object.options.size %> options</span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Label</th>
            <th>Value</th>
            <th class="w-24">Position</th>
            <th class="w-24">Active</th>
            <th class="w-12"></th>
          </tr>
        </thead>
        <tbody>
          <%= f.fields_for :options, f.object.options do |option_form| %>
            <%= render 'option_fields', f: option_form %>
          <% end %>

          <tr data-nested-form-target="target"></tr>

          <tr class="hover-none">
            <td colspan="5" class="text-center p-2">
              <button type="button" data-action="nested-form#add" class="btn btn-secondary py-3 w-full">
                <%= icon('plus') %>
                Add option
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
