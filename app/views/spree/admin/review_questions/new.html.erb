<% content_for :title, 'New Review Question - Review Questions' %>

<% content_for :page_title do %>
  <%= page_header_back_button(spree.admin_review_questions_path) %>
  New review question
<% end %>

<%= form_with model: [:admin, @review_question], url: spree.admin_review_questions_path, data: { controller: 'nested-form', nested_form_wrapper_selector_value: '.nested-form-wrapper' } do |f| %>
  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 lg:col-span-8 lg:col-start-3">
      <%= render 'spree/admin/shared/error_messages', target: @review_question %>
      <%= render 'form', f: f %>
      <%= render 'spree/admin/shared/new_resource_links', f: f %>
    </div>
  </div>
<% end %>
