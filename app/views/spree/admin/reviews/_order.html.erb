<% review = local_assigns.fetch(:review, record) %>
<% order = review.order %>

<% if order.present? %>
  <%= link_to order.number,
              spree.edit_admin_order_path(order),
              class: 'font-medium text-gray-900',
              data: { turbo_frame: '_top' } %>
<% else %>
  <span class="text-gray-400">-</span>
<% end %>
